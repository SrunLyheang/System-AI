DATABASE_URL=

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=
NEXT_PUBLIC_CLERK_SIGN_UP_URL=

NEXT_PUBLIC_LIVEBLOCKS_PUBLIC_KEY=
LIVEBLOCKS_SECRET_KEY=

BLOB_READ_WRITE_TOKEN=

TRIGGER_SECRET_KEY=

# AI providers for the design-agent / generate-spec tasks. generateChatText()
# tries them in this order and falls through on quota/rate-limit errors:
#   1. DeepSeek (paid)   2. OpenRouter   3. Gemini (free tier, 20 req/day)
# At least one key must be set. All endpoints are OpenAI-compatible.
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
# Optional model-id overrides. Defaults: DEEPSEEK_MODEL=deepseek-chat,
# OPENROUTER_MODEL=openrouter/free, GEMINI_MODEL=gemini-3.6-flash.
DEEPSEEK_MODEL=
OPENROUTER_MODEL=
GEMINI_MODEL=
